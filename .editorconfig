# EditorConfig — https://editorconfig.org
# deno fmt is the formatter of record (see deno.json); this keeps every
# other tool aligned with it.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
# Two trailing spaces are meaningful in Markdown (hard line break).
trim_trailing_whitespace = false
