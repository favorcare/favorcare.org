{
  "nodeModulesDir": "manual",
  "tasks": {
    "check": "deno fmt --check && deno lint . && deno check",
    "test": "deno test -A",
    "dev": "vite",
    "build": "vite build",
    "start": "deno serve -A _fresh/server.js",
    "deploy": "deno task build && CF=1 deno run -A npm:wrangler deploy",
    "deploy:dry-run": "deno task build && CF=1 deno run -A npm:wrangler deploy --dry-run",
    "assets:pull": "deno run -A scripts/assets.ts pull",
    "assets:push": "deno run -A scripts/assets.ts push",
    "clone:reference": "deno run -A scripts/clone-diff.ts reference",
    "clone:diff": "deno run -A scripts/clone-diff.ts diff",
    "update": "deno run -A -r jsr:@fresh/update ."
  },
  "lint": {
    "rules": {
      "tags": [
        "fresh",
        "recommended"
      ]
    }
  },
  "exclude": [
    "**/_fresh/*",
    "static",
    "server.js"
  ],
  "fmt": {
    "include": [
      "components/",
      "islands/",
      "routes/",
      "assets/",
      "**/*.ts",
      "**/*.tsx",
      "**/*.css",
      "**/*.md",
      "**/*.json"
    ]
  },
  "imports": {
    "@/": "./",
    "@std/assert": "jsr:@std/assert@^1",
    "@cloudflare/vite-plugin": "npm:@cloudflare/vite-plugin@^1.63.1",
    "fresh": "jsr:@fresh/core@^2.3.3",
    "lucide-preact": "npm:lucide-preact@^1.55.0",
    "playwright": "npm:playwright@^1.64.0",
    "preact": "npm:preact@^10.29.1",
    "@preact/signals": "npm:@preact/signals@^2.9.0",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.1.2",
    "simple-icons": "npm:simple-icons@^16.34.0",
    "vite": "npm:vite@^7.1.3",
    "@types/babel__core": "npm:@types/babel__core@^7.20.5",
    "tailwindcss": "npm:tailwindcss@^4.1.10",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.1.12",
    "wrangler": "npm:wrangler@^4.149.0"
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns"
    ],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ],
    "types": [
      "vite/client"
    ]
  }
}
