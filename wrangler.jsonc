// Cloudflare Workers config (https://developers.cloudflare.com/workers/).
// Deploy: connect this repo in the Cloudflare dashboard (Workers → Create →
// import from GitHub) or `deno run -A npm:wrangler deploy`. Secrets
// (later PAYMONGO_/RESEND_/MAILCHIMP_*) go in the dashboard or via
// `wrangler secret put`, never in this file.
{
  "name": "favorcare-org",
  "main": "./server.js",
  "compatibility_date": "2026-10-11",
  // Plain-text (non-secret) variables. Declared here — NOT the dashboard —
  // because every `wrangler deploy` syncs vars to this file's contents and
  // would remove dashboard-added ones. Read by server.js from the env
  // binding (see utils/assets.ts).
  "vars": {
    "ASSET_BASE_URL": "https://assets.favorcare.media",
    // Analytics identifiers (utils/analytics.ts) — public, committed here
    // like ASSET_BASE_URL. Empty string = that vendor's snippet never
    // renders. Local dev reads .env instead (see .env.example).
    "GA4_MEASUREMENT_ID": "",
    "MIXPANEL_TOKEN": "",
    "CLOUDFLARE_ANALYTICS_TOKEN": ""
  },
  // Fresh's client build output, served natively by Workers Static Assets
  // (assets match first; everything else falls through to the SSR worker).
  // Emitted by the build stage — see scripts/ci-cloudflare-build.sh.
  "assets": {
    "directory": "./_fresh/client",
    "not_found_handling": "none"
  },
  // Enables `wrangler preview` (Workers Builds' preview-branch deploys).
  "previews": {}
}
