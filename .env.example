# Copy to .env (git-ignored) for local dev — `deno task dev` loads it via
# vite.config.ts. All three are public identifiers, not secrets: production
# values live in wrangler.jsonc "vars". Leave a key empty (or delete the
# line) to keep that vendor's snippet off entirely. See DEVELOPMENT.md
# "Analytics & UTM tracking".

# Google Analytics 4 — Admin → Data streams → Web → Measurement ID (G-…)
GA4_MEASUREMENT_ID=

# Mixpanel — Settings → Project Settings → Project Token
MIXPANEL_TOKEN=

# Cloudflare Web Analytics — dash.cloudflare.com → Web Analytics → your site
CLOUDFLARE_ANALYTICS_TOKEN=
