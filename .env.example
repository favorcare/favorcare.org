# Copy to .env.local (git-ignored) for local dev. All values are public
# identifiers, not secrets: production values live in the committed
# .env.production. Leave a key empty (or delete the line) to keep that vendor's
# snippet off entirely. See DEVELOPMENT.md "Analytics & UTM tracking".

# Image CDN base. Leave unset in dev so images come from public/images.
# NEXT_PUBLIC_ASSET_BASE_URL=

# Google Analytics 4 — Admin → Data streams → Web → Measurement ID (G-…)
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Mixpanel — Settings → Project Settings → Project Token
NEXT_PUBLIC_MIXPANEL_TOKEN=

# Cloudflare Web Analytics — dash.cloudflare.com → Web Analytics → your site
NEXT_PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=
