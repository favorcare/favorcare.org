#!/bin/sh
# commit-msg — enforces AGENTS.md's commit rules locally.
# Wired up by `deno task setup` (git config core.hooksPath .githooks).
#
# Rejects:
#   - subjects that are not conventional commits (Merge/Revert exempt)
#   - subjects over 72 characters
#   - AI attribution trailers (Co-Authored-By, Generated with/by)

set -eu

msg_file="$1"

# Drop comment lines (the .gitmessage template shows up in the file).
body=$(grep -v '^#' "$msg_file" || true)
first_line=$(printf '%s\n' "$body" | sed -n '1p')

# Merge and revert subjects get a pass (GitHub merges, `git revert`).
case "$first_line" in
  "Merge "*) exit 0 ;;
  "Revert "*) exit 0 ;;
esac

if [ -z "$first_line" ]; then
  echo "commit-msg: empty commit message" >&2
  exit 1
fi

pattern='^(feat|fix|docs|chore|refactor|test|ci)(\([^)]+\))?!?: .+'
if ! printf '%s\n' "$first_line" | grep -Eq "$pattern"; then
  echo "commit-msg: subject must be 'type(scope): summary'" >&2
  echo "  types: feat fix docs chore refactor test ci" >&2
  echo "  was: $first_line" >&2
  exit 1
fi

subject_len=$(printf '%s' "$first_line" | wc -c | tr -d ' ')
if [ "$subject_len" -gt 72 ]; then
  echo "commit-msg: subject is $subject_len chars (max 72):" >&2
  echo "  $first_line" >&2
  exit 1
fi

if printf '%s\n' "$body" | grep -Eiq \
  '^(co-authored-by|generated with|generated by|generated-by)'; then
  echo "commit-msg: AI attribution lines are banned (Co-Authored-By /" >&2
  echo "  Generated with). Commits are attributed to the human author only." >&2
  exit 1
fi
