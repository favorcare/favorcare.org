{
  "name": "favorcare-org",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vinext-cloudflare deploy",
    "deploy:preview": "vinext-cloudflare deploy --preview",
    "check": "prettier --check . && oxlint && tsc --noEmit",
    "test": "vitest run",
    "setup": "node scripts/setup.ts",
    "assets:pull": "node scripts/assets.ts pull",
    "assets:push": "node scripts/assets.ts push",
    "clone:reference": "node scripts/clone-diff.ts reference",
    "clone:diff": "node scripts/clone-diff.ts diff"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@vinext/cloudflare": "^1.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "lucide-react": "1.65.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "simple-icons": "16.36.0",
    "tailwindcss": "4.3.3",
    "vinext": "1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.7",
    "@types/node": "^24",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cf": "1.0.0-beta.25",
    "oxlint": "1.90.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.5"
  }
}
