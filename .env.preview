# Same values as .env.production, for `pnpm deploy:preview` (Vite mode "preview"
# does not load .env.production). Keep the two in sync.
# Build-time public config for `pnpm build` / deploys. Public identifiers,
# not secrets — committed on purpose. Empty analytics IDs = that vendor's
# snippet never renders. See DEVELOPMENT.md "Analytics & UTM tracking".
NEXT_PUBLIC_ASSET_BASE_URL=https://assets.favorcare.media
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_MIXPANEL_TOKEN=
NEXT_PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=
